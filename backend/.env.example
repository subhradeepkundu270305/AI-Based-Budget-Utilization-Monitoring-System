NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/budget_utilization
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
FRONTEND_ORIGIN=http://localhost:4200
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
UPLOAD_DIR=uploads
CRON_ENABLED=true
GEMINI_API_KEY=your_gemini_or_openrouter_api_key
